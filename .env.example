# Copy to .env for local dev (and the legacy PythonAnywhere host).
# On Cloud Run these come from Secret Manager / --set-env-vars instead - see CLOUDRUN.md.

FLASK_SECRET_KEY=replace-with-a-long-random-string

GEMINI_API_KEY=replace-with-gemini-key
GEMINI_API_KEY_2=replace-with-second-gemini-key
# Optional CSV alternative to the numbered keys above. Keys from both forms are
# combined into one rotation, so leave this commented out unless you use it -
# placeholder values here would be rotated in as real (invalid) keys.
# GEMINI_API_KEYS=key-one,key-two,key-three

PINECONE_API_KEY=replace-with-pinecone-key
PINECONE_INDEX_NAME=football-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Used only by ingest_kb.py, to pull articles from the Wix blog into Pinecone.
WIX_API_KEY=replace-with-wix-api-key
WIX_SITE_ID=replace-with-wix-site-id

# Self-hosted SearXNG instance (Docker image, deployed on Google Cloud Run),
# used as the web-search fallback when Pinecone has no fresh match.
SEARXNG_URL=https://searxng-docker-607277832880.asia-south1.run.app

# Legacy PythonAnywhere only. Leave unset elsewhere - run.py defaults to the
# repo's own config.json.
# OFFTHEBAR_CONFIG_PATH=/home/OffTheBar/OffTheBar/config.json
