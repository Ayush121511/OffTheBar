FLASK_SECRET_KEY=replace-with-a-long-random-string

GEMINI_API_KEY=replace-with-gemini-key
# GEMINI_API_KEY_2=replace-with-second-gemini-key
# GEMINI_API_KEYS=key-one,key-two,key-three

JINA_API_KEY=replace-with-jina-key
HF_TOKEN=replace-with-huggingface-token
PINECONE_API_KEY=replace-with-pinecone-key
PINECONE_INDEX_NAME=football-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_REDIRECT_URI=https://offthebar.pythonanywhere.com/callback
OFFTHEBAR_SECRETS_DIR=/home/OffTheBar/secrets
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=/home/OffTheBar/secrets/google-oauth-client-secret.json
GOOGLE_SERVICE_ACCOUNT_FILE=/home/OffTheBar/secrets/google-service-account.json

OFFTHEBAR_CONFIG_PATH=/home/OffTheBar/OffTheBar/config.json
